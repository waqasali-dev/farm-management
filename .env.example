# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/farm_management

# Redis Cache
REDIS_URL=redis://localhost:6379

# Mock/Fallback Storage (true allows running API in-memory even without active DB/Redis)
FALLBACK_STORAGE=true

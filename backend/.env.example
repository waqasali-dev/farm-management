# ===================================================
# Farm Data Management System - Backend Environment Config
# ===================================================

# Server Port & Host
# Render automatically injects PORT (typically 10000). Host MUST be 0.0.0.0.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Allowed Frontend URL for CORS (set to your Vercel/Netlify/Render domain or * in production)
FRONTEND_URL=http://localhost:5173

# ===================================================
# Database: PostgreSQL
# ===================================================
# Local Development:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/farm_management
# Render / Cloud PostgreSQL (SSL is auto-detected and enabled):
# DATABASE_URL=postgresql://user:password@dpg-xxx.render.com/farm_db?sslmode=require

# ===================================================
# Redis Cache (Upstash REST or Standard TCP)
# ===================================================
# Upstash Redis REST (Recommended for Render, works seamlessly over HTTPS / port 443):
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Standard Redis (Local or Render Redis):
REDIS_URL=redis://localhost:6379

# ===================================================
# Storage Mode
# ===================================================
# In-memory fallback if database is temporarily unavailable (true/false)
FALLBACK_STORAGE=true

# ===================================================
# Authentication (JWT Secret)
# ===================================================
JWT_SECRET=your_super_secret_random_jwt_key_here


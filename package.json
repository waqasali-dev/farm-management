{
  "name": "farm-data-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality farm data management system with strict monochrome UI and flock isolation",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "keywords": [
    "farm-management",
    "poultry",
    "flock-isolation",
    "fastify",
    "react",
    "drizzle",
    "redis"
  ],
  "author": "",
  "license": "ISC"
}
